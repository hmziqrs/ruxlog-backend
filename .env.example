# Core project metadata
ENV_FILE=.env.example
PROJECT=rux_local
APP_ENV=development
DEPLOYMENT_ENVIRONMENT=development
HOST=0.0.0.0
PORT=1100
SITE_URL=http://localhost:1100
SITE_NAME=Ruxlog
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_APP_API_HOST=
ADMIN_PORT=1107
CONSUMER_PORT=1108
CONSUMER_SITE_URL=http://localhost:1108

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=1101
POSTGRES_USER=rroot
POSTGRES_PASSWORD=root
POSTGRES_DB=ruxlog

# Cache (Valkey/Redis)
REDIS_HOST=localhost
REDIS_PORT=1102
REDIS_USER=rred
REDIS_PASSWORD=red
# Encrypt the Redis/Valkey session + cache transport (rediss://). Set true in
# any non-loopback deployment; requires TLS enabled on the Valkey server (the
# app builds a rustls connector from the native cert store). Local plaintext
# dev stays false. See services/redis.rs (plan Phase 6a).
REDIS_TLS=false

# Session/Crypto keys
# V-CRIT-1: MUST rotate to a real CSPRNG key (openssl rand -hex 32) before any
# deploy; this placeholder is committed only so the length guard boots.
COOKIE_KEY=CHANGE_ME_rotate_me_generate_with_openssl_rand_hex_32___________
# CSRF signing key is HKDF-derived from COOKIE_KEY (see static_csrf.rs); no CSRF_KEY needed.
NEW_KEY=ACCELERATE

# Email (Mailtrap defaults)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_USERNAME=mailtrap-username
SMTP_PASSWORD=mailtrap-password
SMTP_PORT=25

# Mail provider selection + shared settings.
#   MAIL_PROVIDER = smtp | cloudflare   (cloudflare needs the block below)
# The selected provider's required vars are read with fail-loud boot: a missing
# CLOUDFLARE_EMAIL_* var panics at startup when MAIL_PROVIDER=cloudflare.
MAIL_PROVIDER=cloudflare
MAIL_FROM_ADDRESS=no-reply@your-verified-domain.tld
MAIL_FROM_NAME=Ruxlog
# Master switch for the per-recipient + provider-quota outbound rate limiter.
MAIL_RATE_LIMIT_ENABLED=true
# Resend-suppression window (identical content) for the newsletter template.
MAIL_DEDUP_TTL_SECS=300
# How long a soft (non-permanent) bounce suppresses a recipient.
MAIL_SOFT_BOUNCE_COOLDOWN_SECS=86400

# Cloudflare Email Sending (only used when MAIL_PROVIDER=cloudflare; needs the
# `mail-cloudflare` feature, on by default). Cloudflare does NOT POST signed
# bounce events natively — async bounces/complaints arrive via a Cloudflare
# Worker that consumes the Email Service event Queue and re-POSTs to
# /mail/v1/webhook/cloudflare under the shared CLOUDFLARE_EMAIL_WEBHOOK_SECRET.
# Synchronous permanent_bounces from the send response are auto-suppressed
# regardless. See docs/cloudflare-email-worker.md.
#
# Left EMPTY so boot fails LOUD (not silently with fake placeholder creds).
# Fill these in, OR set MAIL_PROVIDER=smtp above to use SMTP/Mailtrap instead.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
# Generate an API token with the "Email Sending" permission.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_API_BASE_URL=https://api.cloudflare.com/client/v4
# Shared HMAC secret the reference Worker uses to sign inbound events. If unset
# (empty), the webhook receiver rejects every event (fail-closed) — no committed
# placeholder value that an attacker could forge signatures with. Generate with:
#   openssl rand -hex 32
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=
# Optional comma-separated sandbox allowlist of recipient addresses (pre-prod).
# When set, sends to any recipient not on the list are refused.
CLOUDFLARE_EMAIL_ALLOWED_ADDRESSES=

# Optional legacy Mailgun config
MAILGUN_API_KEY=mailgun-api-key
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USER=postmaster@sandbox.mailgun.org
MAILGUN_SMTP_PASSWORD=mailgun-smtp-password

# Object Storage (S3-compatible: Garage for local dev, R2 for prod)
S3_REGION=garage
S3_ACCOUNT_ID=local-account
S3_BUCKET=ruxlog-assets
S3_ACCESS_KEY=GKffffffffffffffffffffffff
S3_SECRET_KEY=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
S3_PUBLIC_URL=http://127.0.0.1:1105
S3_ENDPOINT=http://127.0.0.1:1105

# Garage single-node cluster defaults
GARAGE_ZONE=dc1
GARAGE_CAPACITY=5G
GARAGE_RPC_SECRET=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
GARAGE_ADMIN_TOKEN=garage-admin-token
GARAGE_METRICS_TOKEN=garage-metrics-token
GARAGE_ACCESS_KEY_NAME=ruxlog-local
GARAGE_RPC_PORT=1103
GARAGE_ADMIN_PORT=1104
GARAGE_S3_PORT=1105
GARAGE_WEB_PORT=1106

# Feature flags
ENABLE_QUICKWIT_OTEL=false
OPTIMIZE_ON_UPLOAD=true
OPTIMIZER_MAX_PIXELS=40000000
OPTIMIZER_KEEP_ORIGINAL=true
OPTIMIZER_WEBP_QUALITY_DEFAULT=80

# Quickwit / OTEL telemetry
QUICKWIT_API_URL=http://localhost:7280
QUICKWIT_INGEST_URL=http://localhost:7280
QUICKWIT_LOGS_INDEX_ID=otel-logs-v0_7
QUICKWIT_TRACES_INDEX_ID=otel-traces-v0_7
QUICKWIT_METRICS_INDEX_ID=otel-metrics-v0_7
QUICKWIT_ACCESS_TOKEN=
OTEL_SERVICE_NAME=ruxlog-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=30000
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_METRIC_EXPORT_TIMEOUT=30000
OTEL_BLRP_MAX_QUEUE_SIZE=2048
OTEL_BLRP_SCHEDULE_DELAY=1000
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BLRP_EXPORT_TIMEOUT=30000
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_HEADERS=

# Third-party integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth providers (feature-gated: auth-oauth). All optional — a provider is only
# active when its *_CLIENT_ID/SECRET/REDIRECT_URI are set. After a successful
# OAuth login the backend redirects the browser to {FRONTEND_URL}/auth/<provider>/success;
# optionally restrict the allowed origin with a comma-separated allow-list.
OAUTH_ALLOWED_REDIRECT_ORIGINS=

# Facebook Sign-In (Graph API v18.0)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# GitHub Sign-In
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Sign-in-with-Apple. The client_secret is a per-request ES256-signed JWT minted
# from TEAM_ID/KEY_ID + the P-256 private key. Provide the .p8 contents inline
# OR a path to the key file (prefer the file path to keep the secret out of env).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-signin-key.p8
APPLE_REDIRECT_URI=

# Firebase Analytics (Frontend - wasm32 only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging (feature-gated: notifications)
# A Google service-account JSON key file authorized for Firebase Messaging
# (Cloud Messaging > Service Accounts). Keep the file out of git — point at a
# mounted secret path. When FCM_ENABLED=false OR the file is absent/unreadable,
# push is skipped but in-app notifications still work.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# Misc runtime tuning
RUST_LOG=info

# ── Billing / Monetization (feature-gated: billing) ──────────────
# Enable in Cargo.toml: billing-stripe, billing-polar, billing-lemonsqueezy,
# billing-paddle, billing-crypto

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# Polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Paddle
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=

# Airwallex (Global / APAC)
# Both base URLs default to the PRODUCTION hosts; override to the Airwallex
# sandbox/demo hosts for development only. AIRWALLEX_CHECKOUT_BASE_URL drives
# the hosted-checkout + customer-portal URLs (previously hardcoded to the demo
# host — see plan Phase 6f).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_API_BASE_URL=https://api.airwallex.com/api/v1
AIRWALLEX_CHECKOUT_BASE_URL=https://checkout.airwallex.com

# Crypto (No-KYC / direct wallet)
CRYPTO_WALLET_ADDRESS=
CRYPTO_API_URL=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_CURRENCY=BTC

# Image moderation (feature-gated: image-moderation)
# An HTTP endpoint that classifies an uploaded image and responds with
# { "safe": bool, "scores": { ... } }. The endpoint receives the raw image
# bytes as the request body, the declared Content-Type as a header, and the
# API key as a Bearer token. When disabled (or URL unset) the gate is a no-op
# and all uploads are accepted; when a provider returns safe=false the upload
# is rejected with 403 OperationNotAllowed before reaching S3. Provider errors
# fail open (upload allowed, logged) so a moderation outage cannot block all
# uploads.
IMAGE_MODERATION_ENABLED=false
IMAGE_MODERATION_URL=
IMAGE_MODERATION_API_KEY=
