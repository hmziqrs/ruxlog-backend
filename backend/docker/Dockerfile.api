# Pinned to the same stable toolchain that owns backend/api/Cargo.lock (matches
# CI's dtolnay/rust-toolchain@stable). An older cargo (e.g. 1.91) resolves a
# different graph than the committed lock and rejects it under --locked. Bump
# this when the lock is regenerated under a newer stable.
FROM rust:1.96.0-slim-trixie AS base
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev libpq-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

# Build backend/api STANDALONE. It is normally a member of the repo-root
# workspace (see /Cargo.toml), so host/CI builds resolve against the ROOT
# Cargo.lock. This image deliberately does NOT copy the root Cargo.toml, so
# cargo treats backend/api as a standalone package and builds against
# backend/api/Cargo.lock — which must therefore be a valid *standalone* lock
# (it is ignored by the root workspace, so it drifts independently).
#
# If `cargo build --release --locked` fails here with "cannot update the lock",
# the standalone lock is stale. Regenerate it in ISOLATION (no root workspace
# visible) and commit:
#   docker run --rm -v "$PWD":/w rust:1.96.0-slim-trixie bash -c '\
#     rm -rf /tmp/i && mkdir -p /tmp/i/backend /tmp/i/crates && \
#     cp -r /w/backend/api /tmp/i/backend/api && \
#     cp -r /w/crates/ruxlog-types /tmp/i/crates/ruxlog-types && \
#     rm -rf /tmp/i/backend/api/target /tmp/i/crates/ruxlog-types/target /tmp/i/backend/api/Cargo.lock && \
#     cd /tmp/i/backend/api && cargo generate-lockfile && \
#     cp Cargo.lock /w/backend/api/Cargo.lock'
FROM base AS builder
COPY backend/api backend/api
COPY crates/ruxlog-types crates/ruxlog-types
WORKDIR /workspace/backend/api
ENV RUSTFLAGS="-C strip=symbols"
RUN cargo build --release --locked

FROM debian:trixie-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 appuser
COPY --from=builder /workspace/backend/api/target/release/ruxlog /app/ruxlog
USER appuser
EXPOSE 8888
CMD ["/app/ruxlog"]
